{
  "name": "sst-sequencer",
  "version": "0.2.0",
  "description": "Electron desktop app for building videos from image sequences and extracting image sequences from videos.",
  "main": "main.cjs",
  "scripts": {
    "postinstall": "node scripts/setup-realesrgan.mjs && node scripts/setup-realcugan.mjs && node scripts/setup-waifu2x.mjs && node scripts/setup-realsr.mjs && node scripts/setup-swinir.mjs && node scripts/setup-dat.mjs && node scripts/setup-anime4kcpp.mjs",
    "setup:realesrgan": "node scripts/setup-realesrgan.mjs",
    "setup:realcugan": "node scripts/setup-realcugan.mjs",
    "setup:waifu2x": "node scripts/setup-waifu2x.mjs",
    "setup:realsr": "node scripts/setup-realsr.mjs",
    "setup:swinir": "node scripts/setup-swinir.mjs",
    "setup:dat": "node scripts/setup-dat.mjs",
    "setup:anime4kcpp": "node scripts/setup-anime4kcpp.mjs",
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "tsc --noEmit && node scripts/run-electron-vite.mjs build",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "dist": "npm run build && electron-builder",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "pixel-scale-epx": "^0.0.129",
    "pngjs": "^7.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "xbr-js": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "7zip-bin": "^5.2.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.7"
  },
  "build": {
    "appId": "com.shadowshardtools.sstsequencer",
    "productName": "SST Sequencer",
    "files": [
      "main.cjs",
      "out/**/*",
      "build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**"
    ],
    "extraResources": [
      {
        "from": "vendor/realesrgan",
        "to": "realesrgan"
      },
      {
        "from": "vendor/realcugan",
        "to": "realcugan"
      },
      {
        "from": "vendor/waifu2x",
        "to": "waifu2x"
      },
      {
        "from": "vendor/realsr",
        "to": "realsr"
      },
      {
        "from": "vendor/swinir",
        "to": "swinir"
      },
      {
        "from": "vendor/dat",
        "to": "dat"
      },
      {
        "from": "vendor/anime4kcpp",
        "to": "anime4kcpp"
      }
    ],
    "win": {
      "icon": "build/SST Sequencer.ico"
    },
    "directories": {
      "output": "release"
    }
  }
}
